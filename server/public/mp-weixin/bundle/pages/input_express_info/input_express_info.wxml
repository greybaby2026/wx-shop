<view class="{{[themeName]}}"><view class="p-24 p-l-30 m-l-20 m-r-20 bg-white br20 m-b-20 m-t-30"><view class="bold">退货商品</view><view class="flex m-t-20"><u-image vue-id="33baba01-1" src="{{orderDetial.goods_snap.image}}" width="120rpx" height="120rpx" mode="aspectFill" border-radius="20" bind:__l="__l"></u-image><view class="m-l-24" style="width:100%;"><view class="nr line-2 m-b-20">{{''+orderDetial.goods_snap.goods_name+''}}</view><view class="xs muted flex row-between"><price class="m-r-12" vue-id="33baba01-2" content="{{orderDetial.goods_price}}" color="#101010" mainSize="28rpx" minorSize="26rpx" bind:__l="__l"></price><text>{{"X "+orderDetial.goods_snap.goods_num}}</text></view></view></view></view><view class><view class="flex m-24 bg-white br20"><view class="label nr normal">物流公司</view><input class="input" type="text" placeholder="请输入物流公司名称" data-event-opts="{{[['input',[['__set_model',['$0','express_name','$event',[]],['form']]]]]}}" value="{{form.express_name}}" bindinput="__e"/></view><view class="flex m-24 bg-white br20"><view class="label nr normal">快递单号</view><input class="input" type="text" placeholder="请输入快递单号" data-event-opts="{{[['input',[['__set_model',['$0','invoice_no','$event',[]],['form']]]]]}}" value="{{form.invoice_no}}" bindinput="__e"/></view></view><view data-event-opts="{{[['tap',[['applyExpressInfo',['$event']]]]]}}" class="btn flex row-center br60 lg white" bindtap="__e"> 提交 </view></view>