ass="flex row-right p-b-24 muted"><label class="m-r-20 _span" style="font-size:26rpx;">{{'最多¥'+$root.g0}}<block wx:if="{{goodsData.express_status==0}}"><label class="_span">{{'，含运费¥'+goodsData.express_price+''}}</label></block></label></view></view><view class="p-t-24 p-l-15 p-r-15 bg-white br20 m-t-24"><view class="p-b-24"><view class="nr normal flex-none">补充描述<label class="muted _span">（选填）</label></view><view class="flex-1 m-t-24"><textarea class="bg-body" style="width:100%;" placeholder="补充描述，有助于商家更好的处理售后问题" name="textarea" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" value="{{remark}}" bindinput="__e"></textarea></view></view><view class="p-t-24 p-l-15 p-b-44"><view class="flex row-between p-b-24"><view class="nr normal">上传凭证</view><view class="muted nr"> （选填，最多可上传3张） </view></view><uploader bind:input="__e" vue-id="ce2698a6-6" mutiple="{{true}}" deletable="{{true}}" preview-size="160rpx" maxUpload="{{3}}" image-fit="aspectFill" value="{{fileList}}" data-event-opts="{{[['^input',[['__set_model',['','fileList','$event',[]]]]]]}}" bind:__l="__l"></uploader></view></view></view></block><block wx:if="{{refund_method!==0}}"><view class="post-btn flex row-center br60 lg white" disabled="{{isLoading}}" data-event-opts="{{[['tap',[['applyRefundFun',['$event']]]]]}}" bindtap="__e"> 提交申请 </view></block><u-popup bind:input="__e" vue-id="ce2698a6-7" id="popup" border-radius="14" mode="bottom" closeable="{{true}}" value="{{showPop}}" data-event-opts="{{[['^input',[['__set_model',['','showPop','$event',[]]]]]]}}" bind:__l="__l" vue-slots="{{['default']}}"><view class="bg-white"><view class="pop-header flex row-center md normal"> 退款原因 </view><scroll-view style="height:800rpx;" scroll-y="{{true}}"><radio-group data-event-opts="{{[['change',[['radioChange',['$event']]]]]}}" class="m-t-20" bindchange="__e"><block wx:for="{{goodsData.reason}}" wx:for-item="item" wx:for-index="index" wx:key="index"><label data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="reason-item flex row-between" bindtap="__e"><view class="reason-desc nr">{{''+item+''}}</view><radio style="transform:scale(0.7);" color="#FF2C3C" value="{{index+''}}"></radio></label></block></radio-group></scroll-view></view></u-popup></view>