page{background-image:linear-gradient(126deg,#e64d33 28.96%,#ec8543);background-size:100% 40%;background-repeat:no-repeat}.red_theme .header{background-image:linear-gradient(90deg,#f95f2f 50%,#ff2c3c)}.orange_theme .header{background-image:linear-gradient(90deg,#ffd200 50%,#f7971e)}.pink_theme .header{background-image:linear-gradient(90deg,#fd498f 50%,#fa444d)}.gold_theme .header{background-image:linear-gradient(90deg,#ebc389 50%,#e0a356)}.blue_theme .header{background-image:linear-gradient(90deg,#56ccf2 50%,#2f80ed)}.green_theme .header{background-image:linear-gradient(90deg,#3de650 50%,#2ec840)}.sign{color:#555;font-size:24rpx;padding:4rpx 10rpx;background-color:#f4f4f4}.footer{left:0;bottom:0;width:100%;height:150rpx;position:fixed;padding-bottom:env(safe-area-inset-bottom);padding:0 20rpx constant(safe-area-inset-bottom) 20rpx}.btn{padding:10rpx 40rpx;border-width:1rpx;border-style:solid}.red_theme .btn{color:#ff2c3c}.orange_theme .btn{color:#f7971e}.pink_theme .btn{color:#fa444d}.gold_theme .btn{color:#e0a356}.blue_theme .btn{color:#2f80ed}.green_theme .btn{color:#2ec840}.red_theme .btn{border-color:#ff2c3c}.orange_theme .btn{border-color:#f7971e}.pink_theme .btn{border-color:#fa444d}.gold_theme .btn{border-color:#e0a356}.blue_theme .btn{border-color:#2f80ed}.green_theme .btn{border-color:#2ec840}.header-text{color:hsla(0,0%,100%,.6)}.express-box{display:flex;padding:5px 16rpx;justify-content:center;align-items:center;border-radius:20px;border:1px solid #333}.express-info{margin-top:20rpx;border-radius:8px;background:#fafafd;height:80rpx;line-height:100rpx}