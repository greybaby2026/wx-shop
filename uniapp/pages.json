                    "style": {
                        "navigationBarTitleText": "注销账号"
                    },
                    "meta": {
                        "auth": false
                    }
                }
            ]
        }
    ],

    //按需注入：小程序启动时只注入当前页面用到的自定义组件与代码，降低冷启动耗时
    //（项目 82 个自有组件 + uView 组件原先会被全量注入）。
    //前置核查（2026-09-24）：全库无 <component :is> 动态组件用法；u-parse 内部亦无动态组件；
    //easycom 规则（^u-(.*) / ^w-(.*)）与按需注入兼容。若日后新增动态组件用法需同步回归。
    "lazyCodeLoading": "requiredComponents",

    //分包预下载：首页停留时预下载 bundle 分包（83/95 个页面在该分包内，原先进入需等待下载→白屏明显）。
    //仅在 wifi 下预下载（不消耗用户移动流量）；bundle 分包体积约 1.5MB，在 2MB 限额内。
    "preloadRule": {
        "pages/index/index": {
            "network": "wifi",
            "packages": ["bundle"]
        }
    },

    "globalStyle": {
        "navigationBarTextStyle": "black",
        "navigationBarTitleText": "",
        "navigationBarBackgroundColor": "#FFFFFF",
        "backgroundColor": "#F8F8F8",
        "h5": {
            "navigationStyle": "custom"
        }
    },
    "tabBar": {
        "custom": true,
        "list": [
            {
                "pagePath": "pages/index/index",
                "text": "首页"
            },
            {
                "pagePath": "pages/category/category",
                "text": "分类"
            },
            {
                "pagePath": "pages/shop_cart/shop_cart",
                "text": "购物车"
            },
            {
                "pagePath": "pages/user/user",
                "text": "个人中心"
            }
        ]
    },
    "easycom": {
        "autoscan": true,
        "custom": {
            "^u-(.*)": "@/components/uview-ui/components/u-$1/u-$1.vue",
            "^w-(.*)": "@/components/widgets/$1/$1.vue"
        }
    }
}
