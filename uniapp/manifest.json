            /* 权限按「最小必要」裁剪（批次3 FIX-U20）：原模板 20 项含多项与业务无关的危险权限，
               会引发应用市场审核问询。已移除：
                 CALL_PHONE                    —— 客服拨号走 uni.makePhoneCall（系统拨号盘 ACTION_DIAL），无需此权限
                 CHANGE_NETWORK_STATE / CHANGE_WIFI_STATE —— 应用不切换网络状态
                 GET_ACCOUNTS                  —— 读取设备账号，与业务无关
                 MOUNT_UNMOUNT_FILESYSTEMS     —— 系统级权限，普通应用不可申请
                 READ_LOGS                     —— 系统级权限，市场审核高风险
                 READ_PHONE_STATE              —— 读取设备标识，属敏感权限
                 WRITE_SETTINGS                —— 系统级权限，普通应用不可申请
               保留项均有对应功能：相机/闪光灯（扫码核销、上传头像、客服发图）、
               粗略定位（门店距离）、网络与 WiFi 状态（网络判断）、音频（直播）、震动、唤醒锁（WebSocket 保活）、
               外部存储（保存图片到相册）。如真机回归发现某功能异常，请先核对是否因此裁剪导致。 */
            "android" : {
                "permissions" : [
                    "<uses-feature android:name=\"android.hardware.camera\"/>",
                    "<uses-feature android:name=\"android.hardware.camera.autofocus\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_COARSE_LOCATION\"/>",
